<Window x:Class="ServiceSenter.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сервисный центр - Администратор" Height="800" Width="1200" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2C2C2C" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Сервисный центр" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="BtnTabRequests" Content="Все заявки" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14" Cursor="Hand" Click="BtnTabRequests_Click"/>
                    <Button x:Name="BtnTabClients" Content="Клиенты" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14" Cursor="Hand" Click="BtnTabClients_Click"/>
                    <Button x:Name="BtnTabDevices" Content="Устройства" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14" Cursor="Hand" Click="BtnTabDevices_Click"/>
                    <Button x:Name="BtnTabEmployees" Content="Сотрудники" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14" Cursor="Hand" Click="BtnTabEmployees_Click"/>
                    <Button x:Name="BtnTabHistory" Content="История статусов" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14" Cursor="Hand" Click="BtnTabHistory_Click"/>
                    <Button x:Name="BtnTabReports" Content="Отчёты" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14" Cursor="Hand" Click="BtnTabReports_Click"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Выход" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14" Cursor="Hand" VerticalAlignment="Bottom" Margin="0,0,0,20" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TxtHeader" Text="Все заявки" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock x:Name="TxtUserInfo" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="14"/>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="10" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="Все заявки" x:Name="TabRequests">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0">
                            <Button Content="Добавить" Width="120" Click="BtnAddRequest_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Редактировать" Width="130" Margin="10,0,0,0" Click="BtnEditRequest_Click"/>
                            <Button Content="Удалить" Width="100" Margin="10,0,0,0" Click="BtnDeleteRequest_Click" Background="#B22222" Foreground="White"/>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0">
                            <Button Content="Добавить" Width="120" Click="BtnAddRequest_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Редактировать" Width="130" Margin="10,0,0,0" Click="BtnEditRequest_Click"/>
                            <Button Content="Удалить" Width="100" Margin="10,0,0,0" Click="BtnDeleteRequest_Click" Background="#B22222" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="№:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBox x:Name="TxtSearchId" Width="40" Height="25" VerticalContentAlignment="Center" TextChanged="TxtSearchId_TextChanged"/>
                            <TextBlock Text="ФИО:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <TextBox x:Name="TxtSearchClient" Width="110" Height="25" VerticalContentAlignment="Center" TextChanged="TxtSearchClient_TextChanged"/>
                            <TextBlock Text="Дата с:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <DatePicker x:Name="DpFilterDateStart" Width="100" Height="25" SelectedDateChanged="DpFilterDate_SelectedDateChanged"/>
                            <TextBlock Text="по:" VerticalAlignment="Center" Margin="2,0,2,0"/>
                            <DatePicker x:Name="DpFilterDateEnd" Width="100" Height="25" SelectedDateChanged="DpFilterDate_SelectedDateChanged"/>
                            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <ComboBox x:Name="CmbFilterStatus" Width="90" Height="25" VerticalContentAlignment="Center" SelectionChanged="CmbFilterStatus_SelectionChanged"/>
                            <TextBlock Text="Мастер:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <ComboBox x:Name="CmbFilterMaster" Width="120" Height="25" VerticalContentAlignment="Center" SelectionChanged="CmbFilterMaster_SelectionChanged"/>
                            <Button Content="Поиск" Width="60" Height="25" Margin="5,0,0,0" Click="BtnSearch_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Сбросить" Width="70" Height="25" Margin="5,0,0,0" Click="BtnResetFilters_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="GridAllRequests" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DateReceived, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Устройство" Binding="{Binding Device.DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="Мастер" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status.StatusName}" Width="120"/>
                                <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Клиенты" x:Name="TabClients">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Добавить" Width="120" Click="BtnAddClient_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Редактировать" Width="130" Margin="10,0,0,0" Click="BtnEditClient_Click"/>
                            <Button Content="Удалить" Width="100" Margin="10,0,0,0" Click="BtnDeleteClient_Click" Background="#B22222" Foreground="White"/>
                        </StackPanel>
                        <DataGrid x:Name="GridClients" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                                <DataGridTextColumn Header="Первый визит" Binding="{Binding FirstContactDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Устройства" x:Name="TabDevices">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Добавить" Width="120" Click="BtnAddDevice_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Редактировать" Width="130" Margin="10,0,0,0" Click="BtnEditDevice_Click"/>
                            <Button Content="Удалить" Width="100" Margin="10,0,0,0" Click="BtnDeleteDevice_Click" Background="#B22222" Foreground="White"/>
                        </StackPanel>
                        <DataGrid x:Name="GridDevices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding DeviceType.TypeName}" Width="120"/>
                                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="150"/>
                                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Сотрудники" x:Name="TabEmployees">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Добавить" Width="120" Click="BtnAddEmployees_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Редактировать" Width="130" Margin="10,0,0,0" Click="BtnEditEmployees_Click"/>
                            <Button Content="Удалить" Width="100" Margin="10,0,0,0" Click="BtnDeleteEmployees_Click" Background="#B22222" Foreground="White"/>
                        </StackPanel>
                        <DataGrid x:Name="GridEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Должность" Binding="{Binding Role.RoleName}" Width="150"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                                <DataGridTextColumn Header="Пароль (Хеш)" Binding="{Binding PasswordHash}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="История статусов" x:Name="TabHistory">
                    <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата изменения" Binding="{Binding ChangeDatetime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="150"/>
                            <DataGridTextColumn Header="Заявка №" Binding="{Binding Request.Id}" Width="100"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Request.Client.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Новый статус" Binding="{Binding Status.StatusName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Отчёты" x:Name="TabReports">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0">
                            <TextBlock Text="Тип отчёта:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="CmbReportType" Width="300" Height="25" VerticalContentAlignment="Center" SelectionChanged="CmbReportType_SelectionChanged">
                                <ComboBoxItem Content="Список всех заявок за период" IsSelected="True"/>
                                <ComboBoxItem Content="Отчёт по загрузке мастеров"/>
                                <ComboBoxItem Content="Отчёт по выполненным работам и стоимости"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker x:Name="DpReportDateStart" Width="110" Height="25"/>

                            <TextBlock Text="по:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <DatePicker x:Name="DpReportDateEnd" Width="110" Height="25"/>

                            <Button Content="Сформировать" Width="110" Height="25" Margin="10,0,0,0" Click="BtnGenerateReport_Click" Background="#2C2C2C" Foreground="White"/>
                        </StackPanel>

                        <DataGrid x:Name="GridReport" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>