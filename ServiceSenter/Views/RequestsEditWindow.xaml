<Window x:Class="ServiceSenter.Views.RequestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявка" Height="600" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Клиент:" FontWeight="Bold"/>
            <ComboBox x:Name="CmbClient" Height="30" Margin="0,5,0,10" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

            <TextBlock Text="Устройство:" FontWeight="Bold"/>
            <ComboBox x:Name="CmbDevice" Height="30" Margin="0,5,0,10" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

            <TextBlock Text="Мастер:" FontWeight="Bold"/>
            <ComboBox x:Name="CmbMaster" Height="30" Margin="0,5,0,10" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

            <TextBlock Text="Статус:" FontWeight="Bold"/>
            <ComboBox x:Name="CmbStatus" Height="30" Margin="0,5,0,10" DisplayMemberPath="StatusName" SelectedValuePath="Id"/>

            <TextBlock Text="Неисправность:" FontWeight="Bold"/>
            <TextBox x:Name="TxtFault" Height="50" Margin="0,5,0,10" TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Стоимость:" FontWeight="Bold"/>
            <TextBox x:Name="TxtCost" Height="30" Margin="0,5,0,10"/>

            <TextBlock Text="Дата приема:" FontWeight="Bold"/>
            <DatePicker x:Name="DpDateReceived" Height="30" Margin="0,5,0,10"/>

            <TextBlock x:Name="TxtError" Foreground="Red" Margin="0,0,0,10" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Отмена" Width="100" Height="35" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Сохранить" Width="100" Height="35" Background="#2C2C2C" Foreground="White" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>