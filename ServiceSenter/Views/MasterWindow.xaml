<Window x:Class="ServiceSenter.Views.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сервисный центр - Мастер" Height="750" Width="1100" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2C2C2C" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Сервисный центр" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="BtnMyRequests" Content="Мои заявки" Height="45" 
                            Background="#3A3A3A" Foreground="White" BorderThickness="0" 
                            HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14"/>
                </StackPanel>

                <Button Grid.Row="1" Content="Выход" Height="45" 
                        Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" 
                        HorizontalContentAlignment="Left" Padding="20,0,0,0" FontSize="14"
                        VerticalAlignment="Bottom" Margin="0,0,0,20" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Мои заявки" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock x:Name="TxtUserInfo" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="14"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="GridMyRequests" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridMyRequests_SelectionChanged" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateReceived, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Client.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Устройство" Binding="{Binding Device.DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status.StatusName}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="White" Grid.Row="2" Padding="20" CornerRadius="8">
                    <Grid x:Name="DetailsPanel" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="Детали заявки" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Клиент:" Grid.Row="0" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtClientName" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Text="Телефон:" Grid.Row="1" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtPhone" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Text="Устройство:" Grid.Row="2" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtDevice" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Text="Модель:" Grid.Row="3" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtModel" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Text="Серийный номер:" Grid.Row="4" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtSerial" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Text="Описание:" Grid.Row="5" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtFault" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="Текущий статус:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtCurrentStatus" Margin="0,0,0,15"/>

                            <TextBlock Text="Новый статус:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbNewStatus" Height="30" DisplayMemberPath="StatusName" Margin="0,0,0,20"/>

                            <Button Content="Сохранить" Width="150" Height="35" HorizontalAlignment="Right" Click="BtnSaveStatus_Click" Background="#2C2C2C" Foreground="White" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>