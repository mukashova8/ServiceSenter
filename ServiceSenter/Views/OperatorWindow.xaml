<Window x:Class="ServiceSenter.Views.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сервисный центр - Оператор" Height="750" Width="1150" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2C2C2C" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Сервисный центр" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="BtnTabRequests" Content="Заявки" Height="45" Background="#3A3A3A" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0" Click="BtnTabRequests_Click"/>
                    <Button x:Name="BtnTabAllRequests" Content="Все заявки" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0" Click="BtnTabAllRequests_Click"/>
                    <Button x:Name="BtnTabClients" Content="Клиенты" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0" Click="BtnTabClients_Click"/>
                    <Button x:Name="BtnTabDevices" Content="Устройства" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0" Click="BtnTabDevices_Click"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Выход" Height="45" Background="Transparent" Foreground="#B0B0B0" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0" VerticalAlignment="Bottom" Margin="0,0,0,20" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TxtHeader" Text="Заявки" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock x:Name="TxtUserInfo" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="14"/>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="10" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="Заявки" x:Name="TabRequests">
                    <Grid Margin="10">
                        <Border Background="White" Padding="15" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Создание заявки" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Grid.Row="0">
                                        <TextBlock Text="Клиент:"/>
                                        <ComboBox x:Name="CmbClient" Height="30" DisplayMemberPath="FullName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="0">
                                        <TextBlock Text="Устройство:"/>
                                        <ComboBox x:Name="CmbDevice" Height="30" DisplayMemberPath="DisplayName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,10,0,0">
                                        <TextBlock Text="Неисправность:"/>
                                        <TextBox x:Name="TxtFault" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,10,0,0">
                                        <TextBlock Text="Мастер:"/>
                                        <ComboBox x:Name="CmbMaster" Height="30" DisplayMemberPath="FullName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,10,0,0">
                                        <TextBlock Text="Статус:"/>
                                        <ComboBox x:Name="CmbStatus" Height="30" DisplayMemberPath="StatusName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,10,0,0">
                                        <TextBlock Text="Дата приема:"/>
                                        <DatePicker x:Name="DpDateReceived" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="3" Margin="0,10,0,0">
                                        <TextBlock Text="Стоимость:"/>
                                        <TextBox x:Name="TxtCost" Height="30" Text="0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Сохранить заявку" Width="200" Height="50" Click="BtnSaveRequest_Click" Background="#2C2C2C" Foreground="White" Margin="10,40,10,0"/>
                                    <Button Content="Печать квитанции" Width="200" Height="50" Click="BtnPrintReceiptFromCreate_Click" Background="#2C2C2C" Foreground="White" Margin="0,40,10,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtMsgRequest" Foreground="Green" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                
                <TabItem Header="Все заявки" x:Name="TabAllRequests">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Редактировать заявку" Width="160" Height="30" Click="BtnEditRequest_Click" Background="#2C2C2C" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="№:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBox x:Name="TxtSearchId" Width="40" Height="25" VerticalContentAlignment="Center"/>
                            <TextBlock Text="ФИО:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <TextBox x:Name="TxtSearchClient" Width="100" Height="25" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Дата с:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <DatePicker x:Name="DpFilterDateStart" Width="100" Height="25"/>
                            <TextBlock Text="по:" VerticalAlignment="Center" Margin="2,0,2,0"/>
                            <DatePicker x:Name="DpFilterDateEnd" Width="100" Height="25"/>
                            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <ComboBox x:Name="CmbFilterStatus" Width="80" Height="25" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Мастер:" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <ComboBox x:Name="CmbFilterMaster" Width="90" Height="25" VerticalContentAlignment="Center"/>
                            <Button Content="Поиск" Width="60" Height="25" Margin="5,0,0,0" Click="BtnSearch_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Сбросить" Width="70" Height="25" Margin="5,0,0,0" Click="BtnResetFilters_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="GridRequests" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DateReceived, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Устройство" Binding="{Binding Device.DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="Мастер" Binding="{Binding Employee.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status.StatusName}" Width="120"/>
                                <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Клиенты" x:Name="TabClients">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Добавить" Width="120" Click="BtnAddClient_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Редактировать" Width="130" Margin="10,0,0,0" Click="BtnEditClient_Click"/>
                            <Button Content="Удалить" Width="100" Margin="10,0,0,0" Click="BtnDeleteClient_Click" Background="#B22222" Foreground="White"/>
                        </StackPanel>
                        <DataGrid x:Name="GridClients" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                                <DataGridTextColumn Header="Первый визит" Binding="{Binding FirstContactDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Устройства" x:Name="TabDevices">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Добавить" Width="120" Click="BtnAddDevice_Click" Background="#2C2C2C" Foreground="White"/>
                            <Button Content="Редактировать" Width="130" Margin="10,0,0,0" Click="BtnEditDevice_Click"/>
                            <Button Content="Удалить" Width="100" Margin="10,0,0,0" Click="BtnDeleteDevice_Click" Background="#B22222" Foreground="White"/>
                        </StackPanel>
                        <DataGrid x:Name="GridDevices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding DeviceType.TypeName}" Width="120"/>
                                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="150"/>
                                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>