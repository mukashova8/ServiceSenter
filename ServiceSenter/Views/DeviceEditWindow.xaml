<Window x:Class="ServiceSenter.Views.DeviceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Устройство" Height="420" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Тип устройства:" FontWeight="Bold"/>
            <ComboBox x:Name="CmbType" Height="30" Margin="0,5,0,10" IsEditable="True"/>

            <TextBlock Text="Производитель:" FontWeight="Bold"/>
            <TextBox x:Name="TxtManufacturer" Height="30" Margin="0,5,0,10" VerticalContentAlignment="Center"/>

            <TextBlock Text="Модель:" FontWeight="Bold"/>
            <TextBox x:Name="TxtModel" Height="30" Margin="0,5,0,10" VerticalContentAlignment="Center"/>

            <TextBlock Text="Серийный номер:" FontWeight="Bold"/>
            <TextBox x:Name="TxtSerial" Height="30" Margin="0,5,0,10" VerticalContentAlignment="Center"/>

            <TextBlock x:Name="TxtError" Foreground="Red" Margin="0,0,0,10" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="100" Height="35" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Сохранить" Width="100" Height="35" Background="#2C2C2C" Foreground="White" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>