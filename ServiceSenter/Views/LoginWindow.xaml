<Window x:Class="ServiceSenter.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сервисный Цетр" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="TxtLogin" Height="30" Margin="0,5,0,15" VerticalContentAlignment="Center"/>
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="TxtPassword" Height="30" Margin="0,5,0,20" VerticalContentAlignment="Center"/>
            <Button Content="Войти" Height="40" Click="BtnLogin_Click" Background="#333333" Foreground="White"/>
            <TextBlock x:Name="TxtError" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>